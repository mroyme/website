---
const today = new Date();

const links = [
  { label: "rss", href: "/rss.xml" },
  { label: "github", href: "https://github.com/mroyme" },
  { label: "x", href: "https://x.com/mroyme" },
  { label: "mastodon", href: "https://mastodon.social/@mroy" },
  { label: "bluesky", href: "https://bsky.app/profile/mroy.me" },
  { label: "linkedin", href: "https://www.linkedin.com/in/madhurjyaroy" },
];

function getExternalLinkProps(href: string) {
  if (!href.startsWith("http")) {
    return {};
  }

  return {
    rel: "noopener noreferrer",
    target: "_blank",
  };
}
---

<footer>
  <ul>
    {
      links.map((link) => (
        <li>
          <a href={link.href} {...getExternalLinkProps(link.href)}>
            <svg
              aria-hidden="true"
              focusable="false"
              width="12"
              height="12"
              viewBox="0 0 12 12"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M2.07102 11.3494L0.963068 10.2415L9.2017 1.98864H2.83807L2.85227 0.454545H11.8438V9.46023H10.2955L10.3097 3.09659L2.07102 11.3494Z"
                fill="currentColor"
              />
            </svg>
            <span>{link.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
  <p>&copy; {today.getFullYear()} Madhurjya Roy</p>
</footer>
<style>
  footer {
    margin: 2rem auto 4rem;
    max-width: 40rem;
    padding: 0 0.5rem;
    color: var(--muted);
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
  }

  a {
    align-items: center;
    border-radius: 0.125rem;
    color: var(--muted);
    display: flex;
    font-size: 0.875rem;
    text-decoration: none;
    transition: color 150ms ease;
  }

  a:hover {
    color: var(--accent);
  }

  svg {
    flex: 0 0 auto;
  }

  span {
    margin-left: 0.5rem;
    min-height: 1.75rem;
  }

  p {
    margin: 0;
  }

  @media (min-width: 768px) {
    ul {
      flex-direction: row;
      gap: 1rem;
    }
  }

  @media (max-width: 720px) {
    footer {
      max-width: calc(100% - 2rem);
      padding: 0;
    }
  }
</style>
